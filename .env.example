# BitCraft Claim Monitor Relay environment example.
# Copy only the values you need into .env for development or into the protected
# preview file /etc/bitcraft-claim-monitor-relay.env. Never commit real secrets.

# Local development (Relay clone ports)
PORT=19428
LOCAL_API_PORT=19430
BITCRAFT_LOCAL_DATA_DIR=apps/bitcraft-local/data

# Relay topology and provider
BITCRAFT_RELAY_ORIGIN=https://relay.bitcraftsync.app
BITCRAFT_APP_IDENTIFIER="BitCraft Claim Monitor Relay (github.com/Red463/bitcraft-claim-monitor-relay)"
ENABLE_RELAY_PROVIDER=true
ENABLE_RELAY_GLOBAL_CATALOG=true
RELAY_HTTP_REFRESH_MS=15000
# RELAY_REGION_MAX_SESSIONS=4
# RELAY_REGION_IDLE_CLOSE_MS=60000
# RELAY_REGION_STAGGER_MS=250
# RELAY_MARKET_REGION_ROTATION_MS=15000
# RELAY_MARKET_REGION_MAX_SESSIONS=4
# RELAY_MARKET_REGION_IDLE_CLOSE_MS=60000
# RELAY_MARKET_REGION_STAGGER_MS=250
# RELAY_EMPIRE_REGION_ROTATION_MS=15000
# RELAY_EMPIRE_REGION_MAX_SESSIONS=4
# RELAY_EMPIRE_REGION_IDLE_CLOSE_MS=60000
# RELAY_EMPIRE_REGION_STAGGER_MS=250

# Standalone preview server
NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=19430
# BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-relay

# Monitored settlement and active regions are administered in the app; the
# Relay region pool settings above bound how those configured regions are read.

# Preview Discord is shadow-only. Runtime validation rejects environment-file
# overrides that would enable live delivery or the gateway in preview mode.
BITCRAFT_DEPLOYMENT_MODE=preview
DISCORD_DELIVERY_MODE=record
ENABLE_DISCORD_STARTUP=false
# Authenticated Admin manual tests may send only to this exact sandbox channel.
# Automatic delivery, DMs, startup, command registration, and jobs stay recorded.
DISCORD_SANDBOX_CHANNEL_ID=

# Admin, OAuth, and optional Discord secrets
DEFAULT_OWNER_DISCORD_ID=145544610234630144
# ADMIN_SETUP_KEY=replace-with-long-random-setup-key
# ENABLE_LEGACY_ADMIN_PASSWORD_AUTH=false
# DISCORD_OAUTH_CLIENT_ID=replace-with-discord-application-id
# DISCORD_OAUTH_CLIENT_SECRET=replace-with-discord-oauth-client-secret
# DISCORD_OAUTH_REDIRECT_URI=https://relay.timbersteeltrade.com/api/local/auth/discord/callback
# DISCORD_BOT_TOKEN=replace-with-discord-bot-token
# DISCORD_APPLICATION_ID=replace-with-discord-application-id
# DISCORD_PUBLIC_KEY=replace-with-discord-public-key
# DISCORD_GUILD_ID=replace-with-discord-server-id

# Background work remains server-owned and does not require a browser.
# ENABLE_SERVER_POLLING=true
# ENABLE_SCHEDULED_JOBS=true

# Optional visitor security / GeoIP configuration
# GEOIP_DATA_PATH=/var/lib/bitcraft-claim-monitor-relay/geoip/geoip.json
# IPAPI_BASE_URL=https://ipapi.co

# Production legal confirmation must be reviewed before enabling.
LEGAL_CONFIGURATION_CONFIRMED=false
