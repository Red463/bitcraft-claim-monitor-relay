{
  "name": "@workspace/bitcraft-local",
  "version": "0.66.2-beta.11",
  "private": true,
  "type": "module",
  "imports": {
    "#map/*": "./src/map/*",
    "#server/*": "./src/server/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "predev:db": "corepack pnpm run build:server",
    "dev:db": "node server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:provider": "tsc -p tsconfig.server.json",
    "build:bindings": "tsc -p tsconfig.bindings.json && vite build --config vite.bindings.config.ts",
    "build:server": "corepack pnpm run build:provider && corepack pnpm run build:bindings",
    "verify:assets": "node scripts/verify-game-assets.mjs",
    "build": "corepack pnpm run build:server && corepack pnpm run verify:assets && tsc -p tsconfig.json --noEmit && vite build && node scripts/verify-relay-runtime-boundaries.mjs",
    "pretest": "corepack pnpm run build:server",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "prestart": "corepack pnpm run build:server",
    "start": "node server.mjs",
    "worker": "node worker.mjs",
    "verify:relay-live": "corepack pnpm run build:server && node scripts/verify-relay-provider-live.mjs",
    "verify:relay-global-live": "corepack pnpm run build:server && node scripts/verify-relay-global-catalog-live.mjs",
    "verify:relay-region-live": "corepack pnpm run build:server && node scripts/verify-relay-primary-region-live.mjs",
    "verify:relay-siege-live": "corepack pnpm run build:server && node scripts/verify-relay-siege-notifications-live.mjs",
    "map:build-terrain-world": "node scripts/build-relay-terrain-world.mjs",
    "map:build-road-world": "node scripts/build-relay-road-world.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "exceljs": "^4.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.3",
    "spacetimedb": "2.7.0",
    "typescript": "~5.9.3",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "catalog:",
    "happy-dom": "^20.11.6"
  }
}
