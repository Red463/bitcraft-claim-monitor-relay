[Unit]
Description=BitCraft Claim Monitor Relay Preview
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitcraft
Group=bitcraft
WorkingDirectory=/opt/bitcraft-claim-monitor-relay/current/apps/bitcraft-local
Environment=NODE_ENV=production
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=19430
Environment=BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-relay
Environment=PRIVACY_LEDGER_PATH=/var/backups/bitcraft-claim-monitor-relay/privacy-deletion-ledger.jsonl
Environment=PRIVACY_LEDGER_KEY_FILE=/etc/bitcraft-claim-monitor-relay/privacy-ledger.key
Environment=MALLOC_TRIM_THRESHOLD_=131072
EnvironmentFile=-/etc/bitcraft-claim-monitor-relay.env
ExecStart=/usr/bin/env BITCRAFT_PROCESS_ROLE=web BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-relay /usr/bin/node /opt/bitcraft-claim-monitor-relay/current/apps/bitcraft-local/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcraft-claim-monitor-relay /var/backups/bitcraft-claim-monitor-relay

[Install]
WantedBy=multi-user.target
