# Canonical production domain.
app.timbersteeltrade.com {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options SAMEORIGIN
	}
	reverse_proxy 127.0.0.1:19430 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		lb_try_duration 5s
		lb_try_interval 250ms
		lb_retry_match {
			method GET HEAD
		}
	}
	handle_errors {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			respond `{"error":"Claim Monitor is updating. Retry in a few seconds."}` 503
		}
		respond "Claim Monitor is updating. Please retry in a few seconds." 503
	}
}


# Relay permanently follows the canonical application host.
relay.timbersteeltrade.com {
	redir https://app.timbersteeltrade.com{uri} permanent
}

# Legacy host redirects.
claim.timbersteeltrade.com {
	redir https://app.timbersteeltrade.com{uri} permanent
}

claim.hostred.co.uk {
	redir https://app.timbersteeltrade.com{uri} permanent
}
