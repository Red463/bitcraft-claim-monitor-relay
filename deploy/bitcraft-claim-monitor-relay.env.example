# Relay preview process configuration.
# Install as /etc/bitcraft-claim-monitor-relay.env with mode 0600.

NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=19430
BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-relay
BITCRAFT_RELAY_ORIGIN=https://relay.bitcraftsync.app
ENABLE_RELAY_PROVIDER=true
RELAY_HTTP_REFRESH_MS=15000

# Routine deployment remains preview-safe and never changes the installed mode.
# Preview is record-only with no Discord gateway. Only the protected production
# cutover workflow may rewrite the installed file to the reviewed canonical set:
# BITCRAFT_DEPLOYMENT_MODE=canonical
# DISCORD_DELIVERY_MODE=live
# ENABLE_DISCORD_STARTUP=true
# DISCORD_OAUTH_REDIRECT_URI=https://app.timbersteeltrade.com/api/local/auth/discord/callback
# LEGAL_CONFIGURATION_CONFIRMED=true
# Canonical activation also requires the configured Discord identity/token and
# a single worker gateway; these comments are documentation, not active values.
BITCRAFT_DEPLOYMENT_MODE=preview
DISCORD_DELIVERY_MODE=record
ENABLE_DISCORD_STARTUP=false

# Authenticated Admin manual tests may send only to this exact sandbox channel.
# It never defaults to a production notification channel.
DISCORD_SANDBOX_CHANNEL_ID=

# Configure secrets only in the installed environment file.
ADMIN_SETUP_KEY=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
FEATUREBASE_JWT_SECRET=
LEGAL_CONFIGURATION_CONFIRMED=false
