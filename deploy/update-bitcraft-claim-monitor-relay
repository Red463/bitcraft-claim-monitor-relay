restore_service_runtime() {
  local service="$1"
  local was_active="$2"
  local label="$3"
  if [[ "$was_active" == "1" ]]; then
    restart_service "$service"
    wait_for_service "$service" "$label"
  else
    systemctl stop "$service" >>"$LOG_FILE" 2>&1 || true
  fi
}

restore_previous_runtime() {
  local status=0
  if [[ "$backup_timer_was_enabled" == "1" ]]; then
    systemctl enable "$BACKUP_TIMER" >>"$LOG_FILE" 2>&1 || status=1
  else
    systemctl disable "$BACKUP_TIMER" >>"$LOG_FILE" 2>&1 || true
  fi
  if [[ "$backup_timer_was_active" == "1" ]]; then
    systemctl start "$BACKUP_TIMER" >>"$LOG_FILE" 2>&1 || status=1
  else
    systemctl stop "$BACKUP_TIMER" >>"$LOG_FILE" 2>&1 || true
  fi
  restore_service_runtime "$WEB_SERVICE" "$web_was_active" "web service" || status=1
  if [[ "$web_was_active" == "1" ]]; then
    wait_for_health "" || status=1
  fi
  restore_service_runtime "$WORKER_SERVICE" "$worker_was_active" "worker service" || status=1
  return "$status"
}

rollback_deployment_transaction() {
  [[ "$transaction_started" == "1" ]] || return 0
  local status=0
  rollback_attempted=1
  log "Restoring previous deployment transaction"
  restore_live_installation || status=1
  restore_previous_runtime || status=1
  if [[ "$status" -eq 0 ]]; then
    transaction_restored=1
  fi
  return "$status"
}

report_retained_recovery_snapshot() {
  local recovery_message="Rollback incomplete. Recovery snapshot retained at: $transaction_dir"
  printf "%s\n" "$recovery_message" >&2
  log_detail "$recovery_message"
}

cleanup_deployment_transaction() {
  local status=$?
  local rollback_status=0
  set +e
  if [[ -n "$MAP_IMPORT_DIR" && "$MAP_IMPORT_DIR" == "$DATA_DIR"/.map-import-* && -d "$MAP_IMPORT_DIR" ]]; then
    rm -rf -- "$MAP_IMPORT_DIR"
  fi
  if [[ -n "$MAP_IMPORT_ARCHIVE" \
    && "$MAP_IMPORT_ARCHIVE" == */bitcraft-map-${MAP_INSTALL_PRODUCT}-${MAP_ARTIFACT_SHA256}.tar.gz \
    && -f "$MAP_IMPORT_ARCHIVE" && ! -L "$MAP_IMPORT_ARCHIVE" ]]; then
    rm -f -- "$MAP_IMPORT_ARCHIVE"
  fi
  if [[ -n "$BUILD_IMPORT_DIR" && "$BUILD_IMPORT_DIR" == "$APP_ROOT"/.build-import-* && -d "$BUILD_IMPORT_DIR" ]]; then
    rm -rf -- "$BUILD_IMPORT_DIR"
  fi
  if [[ -n "$BUILD_IMPORT_ARCHIVE" \
    && "$BUILD_IMPORT_ARCHIVE" == */bitcraft-build-${BUILD_ARTIFACT_SHA256}.tar.gz \
    && -f "$BUILD_IMPORT_ARCHIVE" && ! -L "$BUILD_IMPORT_ARCHIVE" ]]; then
    rm -f -- "$BUILD_IMPORT_ARCHIVE"
  fi
  if [[ "$transaction_started" == "1" \
    && "$deployment_succeeded" != "1" \
    && "$transaction_restored" != "1" \
    && "$rollback_attempted" != "1" ]]; then
    rollback_deployment_transaction
    rollback_status=$?
  fi
  if [[ ( "$deployment_succeeded" == "1" || "$transaction_restored" == "1" ) \
    && -n "$transaction_dir" && -d "$transaction_dir" ]]; then
    rm -rf -- "$transaction_dir"
  elif [[ "$transaction_started" == "1" && -n "$transaction_dir" && -d "$transaction_dir" ]]; then
    report_retained_recovery_snapshot
    rollback_status=1
  fi
  if [[ "$status" -eq 0 && "$rollback_status" -ne 0 ]]; then
    status="$rollback_status"
  fi
  return "$status"
}

read_schema_version() {
  local marker="$1/deploy/database-schema-version"
  local value
  [[ -f "$marker" ]] || return 1
  value="$(tr -d '[:space:]' <"$marker")"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
  printf "%s\n" "$value"
}

schema_backup_kind() {
  local previous_version candidate_version
  previous_version="$(read_schema_version "$1" 2>/dev/null || true)"
  candidate_version="$(read_schema_version "$2" 2>/dev/null || true)"
  if [[ -z "$previous_version" || -z "$candidate_version" || "$previous_version" != "$candidate_version" ]]; then
    printf "migration\n"
  elif [[ "$FORCE_BACKUP" == "1" ]]; then
    printf "manual\n"
  else
    printf "none\n"
  fi
}

create_required_backup() {
  local kind="$1"
  [[ -f "$DATA_DIR/bitcraft-local.sqlite" ]] || {
    printf "Database does not exist yet; no deployment backup is needed.\n"
    return 0
  }
  case "$kind" in
    migration)
      run_logged "Creating schema-migration database backup" \
        "$BACKUP_HELPER_PATH" migration --revision "$REVISION"
      ;;
    manual)
      run_logged "Creating manually requested database backup" \
        "$BACKUP_HELPER_PATH" manual --revision "$REVISION"
      ;;
    none)
      printf "Database schema is unchanged; deployment backup skipped.\n"
      ;;
    *)
      printf "Unknown backup kind: %s\n" "$kind" >&2
      return 1
      ;;
  esac
}

