delegate_cutover_mode() {
  [[ -f "$CUTOVER_HELPER_PATH" && ! -L "$CUTOVER_HELPER_PATH" ]] || {
    printf "Cutover helper is unavailable: %s\n" "$CUTOVER_HELPER_PATH" >&2
    return 1
  }
  case "$CUTOVER_MODE" in
    prepare)
      exec env BITCRAFT_CUTOVER_UPDATER=1 node "$CUTOVER_HELPER_PATH" \
        --revision "$REVISION" --prepare-cutover --confirmation "$CUTOVER_CONFIRMATION"
      ;;
    apply)
      if [[ "$SKIP_CUTOVER_SOAK" == "1" ]]; then
        exec env BITCRAFT_CUTOVER_UPDATER=1 node "$CUTOVER_HELPER_PATH" \
          --revision "$REVISION" --apply-cutover --manifest-hash "$CUTOVER_MANIFEST_HASH" --skip-soak
      fi
      exec env BITCRAFT_CUTOVER_UPDATER=1 node "$CUTOVER_HELPER_PATH" \
        --revision "$REVISION" --apply-cutover --manifest-hash "$CUTOVER_MANIFEST_HASH"
      ;;
    abort)
      exec env BITCRAFT_CUTOVER_UPDATER=1 node "$CUTOVER_HELPER_PATH" \
        --revision "$REVISION" --abort-cutover --manifest-hash "$CUTOVER_MANIFEST_HASH"
      ;;
  esac
}

log() {
  printf "\n== %s ==\n" "$1"
}

initialize_log() {
  umask 077
  if [[ -n "$LOG_FILE" ]]; then
    [[ ! -e "$LOG_FILE" && ! -L "$LOG_FILE" ]] || {
      printf "Refusing to overwrite existing log path: %s\n" "$LOG_FILE" >&2
      return 1
    }
    (set -o noclobber; : >"$LOG_FILE")
  else
    install -d -o root -g root -m 0700 "$LOG_DIR"
    LOG_FILE="$(mktemp "$LOG_DIR/update.XXXXXX.log")"
  fi
  chmod 0600 "$LOG_FILE"
}

log_detail() {
  printf "%s\n" "$*" >>"$LOG_FILE"
}

print_log_tail() {
  if [[ -f "$LOG_FILE" ]]; then
    printf "\nLast log lines from %s:\n" "$LOG_FILE"
    tail -n 80 "$LOG_FILE" || true
  fi
}

run_logged() {
  local label="$1"
  shift

  log "$label"
  log_detail "== $label =="
  log_detail "+ $*"
  set +e
  if [[ "$VERBOSE" == "1" ]]; then
    "$@" 2>&1 | tee -a "$LOG_FILE"
  else
    "$@" >>"$LOG_FILE" 2>&1
  fi
  local status=$?
  set -e
  if [[ "$status" -eq 0 ]]; then
    printf "%s ok\n" "$label"
    return 0
  fi

  printf "%s failed (exit %s)\n" "$label" "$status"
  print_log_tail
  return "$status"
}

run_git_as_user() {
  sudo -u "$RUN_USER" env HOME="$RUN_HOME" \
    GIT_SSH_COMMAND="ssh -F $RUN_SSH_CONFIG" git "$@"
}

sync_source_revision() {
  run_logged "Fetching latest code" run_git_as_user \
    -C "$SOURCE_DIR" fetch --prune origin main
  run_git_as_user -C "$SOURCE_DIR" merge-base --is-ancestor "$REVISION" origin/main || {
    echo "Requested revision is not reachable from origin/main."
    return 1
  }
}

service_summary() {
  local service="$1"
  local label="$2"
  local state pid active_since

  state="$(systemctl show "$service" --property=ActiveState --value 2>/dev/null || printf "unknown")"
  pid="$(systemctl show "$service" --property=MainPID --value 2>/dev/null || printf "0")"
  active_since="$(systemctl show "$service" --property=ActiveEnterTimestamp --value 2>/dev/null || printf "")"
  printf "%s: %s pid=%s" "$label" "$state" "$pid"
  if [[ -n "$active_since" ]]; then
    printf " since=%s" "$active_since"
  fi
  printf "\n"
}

service_journal_tail() {
  local service="$1"
  printf "\nRecent journal for %s:\n" "$service"
  journalctl -u "$service" -n 80 --no-pager -l || true
}

wait_for_service() {
  local service="$1"
  local label="$2"

  printf "Waiting for %s" "$label"
  for _ in {1..30}; do
    if systemctl is-active --quiet "$service"; then
      printf " ok\n"
      service_summary "$service" "$label"
      return 0
    fi
    printf "."
    sleep 1
  done

  printf " failed\n"
  service_summary "$service" "$label" || true
  service_journal_tail "$service"
  return 1
}

health_summary() {
  node -e '
const payload = process.argv[1] || "{}";
try {
  const data = JSON.parse(payload);
  const polling = data.polling || {};
  const version = data.version || data.appVersion || data.release?.version || "unknown";
  console.log(`Health: ok=${data.ok === true}, polling enabled=${polling.enabled === true}, version=${version}`);
} catch {
  console.log("Health: response was not JSON");
}
' "$1"
}

wait_for_health() {
  local expected_version="${1:-}"
  local response

  printf "Waiting for web health at %s" "$HEALTH_URL"
  for _ in {1..12}; do
    if response="$(curl -fsS --connect-timeout 1 --max-time 10 --header "Host: $HEALTH_HOST" "$HEALTH_URL" 2>>"$LOG_FILE")" \
      && node -e '
        const data = JSON.parse(process.argv[1]);
        const expected = process.argv[2];
        const actual = data.version || data.appVersion || data.release?.version || "";
        process.exit(data.ok === true && (!expected || actual === expected) ? 0 : 1);
      ' "$response" "$expected_version"; then
      printf " ok\n"
      HEALTH_SUMMARY="$(health_summary "$response")"
      printf "%s\n" "$HEALTH_SUMMARY"
      log_detail "Health response: $response"
      return 0
    fi
    printf "."
    sleep 2
  done

  printf " failed\n"
  curl -v --max-time 5 --header "Host: $HEALTH_HOST" "$HEALTH_URL" >>"$LOG_FILE" 2>&1 || true
  print_log_tail
  return 1
}

public_http_check() {
  local status final_url
  if [[ "$SKIP_PUBLIC_CHECK" == "1" ]]; then
    PUBLIC_SUMMARY="Public: skipped (--no-public-check)"
    printf "%s\n" "$PUBLIC_SUMMARY"
    return 0
  fi

  status="$(curl -fsSIL --max-time 10 -o /dev/null -w "%{http_code}" "$PUBLIC_URL" 2>>"$LOG_FILE")" || {
    PUBLIC_SUMMARY="Public: check failed status=none url=$PUBLIC_URL"
    printf "%s\n" "$PUBLIC_SUMMARY"
    return 1
  }
  final_url="$(curl -fsSIL --max-time 10 -o /dev/null -w "%{url_effective}" "$PUBLIC_URL" 2>>"$LOG_FILE")" || {
    PUBLIC_SUMMARY="Public: check failed status=$status url=$PUBLIC_URL"
    printf "%s\n" "$PUBLIC_SUMMARY"
    return 1
  }
  if [[ "$status" =~ ^[23] ]]; then
    PUBLIC_SUMMARY="Public: ok status=$status url=$final_url"
    printf "%s\n" "$PUBLIC_SUMMARY"
    return 0
  fi

  PUBLIC_SUMMARY="Public: check failed status=${status:-none} url=$final_url"
  printf "%s\n" "$PUBLIC_SUMMARY"
  return 1
}

