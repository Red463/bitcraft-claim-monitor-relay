#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="${APP_ROOT:-/opt/bitcraft-claim-monitor-relay}"
SOURCE_DIR="${SOURCE_DIR:-$APP_ROOT/source}"
RELEASES_DIR="${RELEASES_DIR:-$APP_ROOT/releases}"
CURRENT_LINK="${CURRENT_LINK:-$APP_ROOT/current}"
DATA_DIR="${DATA_DIR:-/var/lib/bitcraft-claim-monitor-relay}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/bitcraft-claim-monitor-relay}"
CONFIG_DIR="${CONFIG_DIR:-/etc/bitcraft-claim-monitor-relay}"
BACKUP_HELPER_PATH="${BACKUP_HELPER_PATH:-/usr/local/bin/backup-bitcraft-claim-monitor-relay}"
BACKUP_CRYPTO_HELPER_PATH="${BACKUP_CRYPTO_HELPER_PATH:-/usr/local/lib/bitcraft-claim-monitor-relay/backup-crypto.mjs}"
PRIVACY_REPLAY_HELPER_PATH="${PRIVACY_REPLAY_HELPER_PATH:-/usr/local/lib/bitcraft-claim-monitor-relay/replay-privacy-deletions.mjs}"
UPDATER_PATH="${UPDATER_PATH:-/usr/local/bin/update-bitcraft-claim-monitor-relay}"
CUTOVER_HELPER_PATH="${CUTOVER_HELPER_PATH:-$CURRENT_LINK/deploy/cutover-relay-production.mjs}"
SYSTEMD_DIR="${SYSTEMD_DIR:-/etc/systemd/system}"
LOCK_FILE="${LOCK_FILE:-/run/lock/bitcraft-claim-monitor-relay-deploy.lock}"
KEEP_RELEASES="${KEEP_RELEASES:-3}"
RUN_USER="${RUN_USER:-bitcraft}"
RUN_HOME="${RUN_HOME:-$APP_ROOT}"
RUN_SSH_CONFIG="${RUN_SSH_CONFIG:-$RUN_HOME/.ssh/config}"
WEB_SERVICE="${WEB_SERVICE:-bitcraft-claim-monitor-relay.service}"
WORKER_SERVICE="${WORKER_SERVICE:-bitcraft-claim-monitor-relay-worker.service}"
COLLECTOR_TIMER="${COLLECTOR_TIMER:-bitcraft-claim-monitor-relay-collector.timer}"
BACKUP_TIMER="${BACKUP_TIMER:-bitcraft-claim-monitor-relay-backup.timer}"
MAP_TERRAIN_SERVICE="${MAP_TERRAIN_SERVICE:-bitcraft-claim-monitor-relay-map-terrain.service}"
MAP_TERRAIN_TIMER="${MAP_TERRAIN_TIMER:-bitcraft-claim-monitor-relay-map-terrain.timer}"
MAP_ROADS_SERVICE="${MAP_ROADS_SERVICE:-bitcraft-claim-monitor-relay-map-roads.service}"
MAP_ROADS_TIMER="${MAP_ROADS_TIMER:-bitcraft-claim-monitor-relay-map-roads.timer}"
HEALTH_URL="${HEALTH_URL:-http://127.0.0.1:19430/api/local/health}"
HEALTH_HOST="${HEALTH_HOST:-app.timbersteeltrade.com}"
PUBLIC_URL="${PUBLIC_URL:-https://relay.timbersteeltrade.com}"
LOG_DIR="${LOG_DIR:-/var/log/bitcraft-claim-monitor-relay}"
LOG_FILE="${LOG_FILE:-}"
VERBOSE=0
SKIP_PUBLIC_CHECK=0
FORCE_BACKUP=0
REVISION=""
REVISION_SEEN=0
CUTOVER_MODE=""
CUTOVER_CONFIRMATION=""
CUTOVER_CONFIRMATION_SEEN=0
CUTOVER_MANIFEST_HASH=""
CUTOVER_MANIFEST_HASH_SEEN=0
SKIP_CUTOVER_SOAK=0
RETIRED_PUBLIC_PROFILE_MODE=""
MAP_GENERATION_MODE=""
MAP_GENERATION_MODE_SEEN=0
MAP_INSTALL_PRODUCT=""
MAP_INSTALL_PRODUCT_SEEN=0
MAP_ARTIFACT_SHA256=""
MAP_ARTIFACT_SHA256_SEEN=0
MAP_IMPORT_DIR=""
MAP_IMPORT_ARCHIVE=""
BUILD_ARTIFACT_SHA256=""
BUILD_ARTIFACT_SHA256_SEEN=0
BUILD_IMPORT_DIR=""
BUILD_IMPORT_ARCHIVE=""
HEALTH_SUMMARY="Health: not checked"
PUBLIC_SUMMARY="Public: skipped"
deployment_succeeded=0
transaction_started=0
transaction_restored=0
rollback_attempted=0
transaction_dir=""
web_was_active=0
worker_was_active=0
backup_timer_was_active=0
backup_timer_was_enabled=0

usage() {
  cat <<USAGE
Usage: update-bitcraft-claim-monitor-relay --revision <full-sha> --build-artifact-sha256 <64hex> [--verbose] [--no-public-check] [--force-backup]
       update-bitcraft-claim-monitor-relay --revision <full-sha> --prepare-cutover --confirmation app.timbersteeltrade.com
       update-bitcraft-claim-monitor-relay --revision <full-sha> --apply-cutover --manifest-hash <64hex> [--skip-soak]
       update-bitcraft-claim-monitor-relay --revision <full-sha> --abort-cutover --manifest-hash <64hex>
       update-bitcraft-claim-monitor-relay --revision <full-sha> --generate-map all
       update-bitcraft-claim-monitor-relay --revision <full-sha> --install-map-product terrain|roads --artifact-sha256 <64hex>
       update-bitcraft-claim-monitor-relay --revision <full-sha> --inspect-retired-public-profile
       update-bitcraft-claim-monitor-relay --revision <full-sha> --remove-retired-public-profile --confirmation <exact-confirmation>

  --revision <sha>  Deploy this full lowercase commit SHA from origin/main.
  --verbose         Stream install/build output while also logging it.
  --no-public-check Skip the public HTTPS check after local health passes.
  --force-backup    Create a manual backup even when the schema is unchanged.
  --prepare-cutover Prepare the protected canonical production cutover.
  --apply-cutover   Apply the matching prepared cutover.
  --abort-cutover   Restore the matching prepared cutover before admission.
  --skip-soak       Explicitly skip the timed post-admission soak during apply.
  --generate-map    Generate terrain then roads for the active revision and enable their timers.
  --install-map-product  Install one verified map product generated by GitHub Actions.
  --artifact-sha256 Verify the product archive before extracting or installing it.
  --build-artifact-sha256 Verify and install the revision-bound CI build outputs.
  --inspect-retired-public-profile  Inspect the retired profile through the protected root boundary.
  --remove-retired-public-profile  Permanently remove the retired profile through the protected root boundary.
USAGE
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --revision)
        [[ $# -ge 2 ]] || { echo "--revision requires a value."; exit 2; }
        [[ "$REVISION_SEEN" == "0" ]] || { echo "Duplicate --revision is not allowed."; exit 2; }
        REVISION_SEEN=1
        REVISION="$2"
        shift 2
        ;;
      --verbose)
        VERBOSE=1
        shift
        ;;
      --no-public-check)
        SKIP_PUBLIC_CHECK=1
        shift
        ;;
      --force-backup)
        FORCE_BACKUP=1
        shift
        ;;
      --prepare-cutover|--apply-cutover|--abort-cutover)
        [[ -z "$CUTOVER_MODE" ]] || { echo "Unknown or mixed cutover mode."; exit 2; }
        CUTOVER_MODE="${1#--}"
        CUTOVER_MODE="${CUTOVER_MODE%-cutover}"
        shift
        ;;
      --inspect-retired-public-profile)
        [[ -z "$RETIRED_PUBLIC_PROFILE_MODE" ]] || { echo "Duplicate or mixed retired profile mode."; exit 2; }
        RETIRED_PUBLIC_PROFILE_MODE="inspect"
        shift
        ;;
      --remove-retired-public-profile)
        [[ -z "$RETIRED_PUBLIC_PROFILE_MODE" ]] || { echo "Duplicate or mixed retired profile mode."; exit 2; }
        RETIRED_PUBLIC_PROFILE_MODE="remove"
        shift
        ;;
      --confirmation)
        [[ $# -ge 2 ]] || { echo "--confirmation requires a value."; exit 2; }
        [[ "$CUTOVER_CONFIRMATION_SEEN" == "0" ]] || { echo "Duplicate --confirmation is not allowed."; exit 2; }
        CUTOVER_CONFIRMATION_SEEN=1
        CUTOVER_CONFIRMATION="$2"
        shift 2
        ;;
      --manifest-hash)
        [[ $# -ge 2 ]] || { echo "--manifest-hash requires a value."; exit 2; }
        [[ "$CUTOVER_MANIFEST_HASH_SEEN" == "0" ]] || { echo "Duplicate --manifest-hash is not allowed."; exit 2; }
        CUTOVER_MANIFEST_HASH_SEEN=1
        CUTOVER_MANIFEST_HASH="$2"
        shift 2
        ;;
      --skip-soak)
        [[ "$SKIP_CUTOVER_SOAK" == "0" ]] || { echo "Duplicate --skip-soak is not allowed."; exit 2; }
        SKIP_CUTOVER_SOAK=1
        shift
        ;;
      --generate-map)
        [[ $# -ge 2 ]] || { echo "--generate-map requires a value."; exit 2; }
        [[ "$MAP_GENERATION_MODE_SEEN" == "0" && "$2" == "all" ]] || { echo "--generate-map accepts exactly 'all' once."; exit 2; }
        MAP_GENERATION_MODE_SEEN=1
        MAP_GENERATION_MODE="$2"
        shift 2
        ;;
      --install-map-product)
        [[ $# -ge 2 ]] || { echo "--install-map-product requires a value."; exit 2; }
        [[ "$MAP_INSTALL_PRODUCT_SEEN" == "0" && ( "$2" == "terrain" || "$2" == "roads" ) ]] \
          || { echo "--install-map-product accepts terrain or roads exactly once."; exit 2; }
        MAP_INSTALL_PRODUCT_SEEN=1
        MAP_INSTALL_PRODUCT="$2"
        shift 2
        ;;
      --artifact-sha256)
        [[ $# -ge 2 ]] || { echo "--artifact-sha256 requires a value."; exit 2; }
        [[ "$MAP_ARTIFACT_SHA256_SEEN" == "0" && "$2" =~ ^[0-9a-f]{64}$ ]] \
          || { echo "--artifact-sha256 requires one lowercase SHA-256 value."; exit 2; }
        MAP_ARTIFACT_SHA256_SEEN=1
        MAP_ARTIFACT_SHA256="$2"
        shift 2
        ;;
      --build-artifact-sha256)
        [[ $# -ge 2 ]] || { echo "--build-artifact-sha256 requires a value."; exit 2; }
        [[ "$BUILD_ARTIFACT_SHA256_SEEN" == "0" && "$2" =~ ^[0-9a-f]{64}$ ]] \
          || { echo "--build-artifact-sha256 requires one lowercase SHA-256 value."; exit 2; }
        BUILD_ARTIFACT_SHA256_SEEN=1
        BUILD_ARTIFACT_SHA256="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1"
        usage
        exit 2
        ;;
    esac
  done

  if [[ ! "$REVISION" =~ ^[0-9a-f]{40}$ ]]; then
    echo "--revision must be a full 40-character lowercase Git commit SHA."
    exit 2
  fi

  if [[ -n "$RETIRED_PUBLIC_PROFILE_MODE" ]]; then
    [[ -z "$CUTOVER_MODE" \
      && -z "$MAP_GENERATION_MODE" \
      && -z "$MAP_INSTALL_PRODUCT" \
      && "$MAP_ARTIFACT_SHA256_SEEN" == "0" \
      && "$BUILD_ARTIFACT_SHA256_SEEN" == "0" \
      && "$VERBOSE" == "0" \
      && "$SKIP_PUBLIC_CHECK" == "0" \
      && "$FORCE_BACKUP" == "0" \
      && "$CUTOVER_MANIFEST_HASH_SEEN" == "0" \
      && "$SKIP_CUTOVER_SOAK" == "0" ]] \
      || { echo "Unknown or mixed retired profile mode."; exit 2; }
    if [[ "$RETIRED_PUBLIC_PROFILE_MODE" == "inspect" ]]; then
      [[ "$CUTOVER_CONFIRMATION_SEEN" == "0" ]] \
        || { echo "Unknown or mixed retired profile mode."; exit 2; }
    else
      [[ "$CUTOVER_CONFIRMATION_SEEN" == "1" \
        && "$CUTOVER_CONFIRMATION" == "remove-claim-monitor."com ]] \
        || { echo "Unknown or mixed retired profile mode."; exit 2; }
    fi
  elif [[ -n "$CUTOVER_MODE" ]]; then
    if [[ "$VERBOSE" == "1" || "$SKIP_PUBLIC_CHECK" == "1" || "$FORCE_BACKUP" == "1" ]]; then
      echo "Unknown or mixed cutover mode."
      exit 2
    fi
    case "$CUTOVER_MODE" in
      prepare)
        [[ "$CUTOVER_CONFIRMATION_SEEN" == "1" \
          && "$CUTOVER_CONFIRMATION" == "app.timbersteeltrade.com" \
          && "$CUTOVER_MANIFEST_HASH_SEEN" == "0" \
          && "$SKIP_CUTOVER_SOAK" == "0" ]] \
          || { echo "Unknown or mixed cutover mode."; exit 2; }
        ;;
      apply|abort)
        [[ "$CUTOVER_CONFIRMATION_SEEN" == "0" \
          && "$CUTOVER_MANIFEST_HASH_SEEN" == "1" \
          && "$CUTOVER_MANIFEST_HASH" =~ ^[0-9a-f]{64}$ ]] \
          || { echo "Unknown or mixed cutover mode."; exit 2; }
        [[ "$CUTOVER_MODE" == "apply" || "$SKIP_CUTOVER_SOAK" == "0" ]] \
          || { echo "Unknown or mixed cutover mode."; exit 2; }
        ;;
      *)
        echo "Unknown or mixed cutover mode."
        exit 2
        ;;
    esac
  elif [[ "$CUTOVER_CONFIRMATION_SEEN" == "1" || "$CUTOVER_MANIFEST_HASH_SEEN" == "1" || "$SKIP_CUTOVER_SOAK" == "1" ]]; then
    echo "Unknown or mixed cutover mode."
    exit 2
  fi
  if [[ -n "$MAP_GENERATION_MODE" && ( -n "$CUTOVER_MODE" || -n "$RETIRED_PUBLIC_PROFILE_MODE" || "$VERBOSE" == "1" || "$SKIP_PUBLIC_CHECK" == "1" || "$FORCE_BACKUP" == "1" ) ]]; then
    echo "Unknown or mixed map generation mode."
    exit 2
  fi
  if [[ -n "$MAP_INSTALL_PRODUCT" ]]; then
    if [[ "$MAP_ARTIFACT_SHA256_SEEN" != "1" || -n "$CUTOVER_MODE" || -n "$RETIRED_PUBLIC_PROFILE_MODE" || -n "$MAP_GENERATION_MODE" \
      || "$VERBOSE" == "1" || "$SKIP_PUBLIC_CHECK" == "1" || "$FORCE_BACKUP" == "1" ]]; then
      echo "Unknown or mixed map installation mode."
      exit 2
    fi
  elif [[ "$MAP_ARTIFACT_SHA256_SEEN" == "1" ]]; then
    echo "--artifact-sha256 requires --install-map-product."
    exit 2
  fi
  if [[ "$BUILD_ARTIFACT_SHA256_SEEN" == "1" ]]; then
    if [[ -n "$CUTOVER_MODE" || -n "$RETIRED_PUBLIC_PROFILE_MODE" || -n "$MAP_GENERATION_MODE" || -n "$MAP_INSTALL_PRODUCT" ]]; then
      echo "Unknown or mixed build artifact mode."
      exit 2
    fi
  elif [[ -z "$CUTOVER_MODE" && -z "$RETIRED_PUBLIC_PROFILE_MODE" && -z "$MAP_GENERATION_MODE" && -z "$MAP_INSTALL_PRODUCT" ]]; then
    echo "Ordinary deployments require --build-artifact-sha256."
    exit 2
  fi
}

delegate_retired_public_profile_mode() {
  local active_release helper
  active_release="$(readlink -f "$CURRENT_LINK")"
  [[ -n "$active_release" && "$(basename "$active_release")" == "$REVISION" ]] || {
    printf "Retired profile operation requires the active deployed revision.\n" >&2
    return 1
  }
  helper="$active_release/deploy/remove-retired-public-profile.mjs"
  [[ -f "$helper" && ! -L "$helper" ]] || {
    printf "Retired profile removal helper is unavailable.\n" >&2
    return 1
  }
  node --check "$helper"
  case "$RETIRED_PUBLIC_PROFILE_MODE" in
    inspect)
      exec node "$helper" --inspect
      ;;
    remove)
      exec env BITCRAFT_RETIRED_PUBLIC_REMOVAL=1 node "$helper" \
        --apply --revision "$REVISION" --confirmation "$CUTOVER_CONFIRMATION" --locked-deploy
      ;;
    *)
      printf "Unknown retired profile operation.\n" >&2
      return 2
      ;;
  esac
}

start_and_wait_for_map_generation() {
  local service="$1"
  run_logged "Running $service" systemctl start "$service"
}

generate_native_map_packs() {
  local current_revision
  current_revision="$(basename "$(readlink -f "$CURRENT_LINK")")"
  [[ "$current_revision" == "$REVISION" ]] || {
    printf "Active revision %s does not match requested map revision %s.\n" "$current_revision" "$REVISION" >&2
    return 1
  }
  start_and_wait_for_map_generation "$MAP_TERRAIN_SERVICE"
  run_logged "Validating terrain map pack" sudo -u "$RUN_USER" node \
    "$CURRENT_LINK/apps/bitcraft-local/scripts/verify-native-map-pack.mjs" \
    --data-dir "$DATA_DIR" --product terrain
  if ! start_and_wait_for_map_generation "$MAP_ROADS_SERVICE"; then
    log "Reporting native map serving diagnostics"
    node "$CURRENT_LINK/deploy/diagnose-native-map-serving.mjs" || true
    return 1
  fi
  run_logged "Validating road map pack" sudo -u "$RUN_USER" node \
    "$CURRENT_LINK/apps/bitcraft-local/scripts/verify-native-map-pack.mjs" \
    --data-dir "$DATA_DIR" --product roads
  run_logged "Validating served native map" sudo -u "$RUN_USER" node \
    "$CURRENT_LINK/apps/bitcraft-local/scripts/verify-native-map-pack.mjs" \
    --data-dir "$DATA_DIR" --serve-base-url "http://127.0.0.1:19430"
  log "Reporting native map serving diagnostics"
  node "$CURRENT_LINK/deploy/diagnose-native-map-serving.mjs"
  systemctl enable --now "$MAP_TERRAIN_TIMER" "$MAP_ROADS_TIMER" >>"$LOG_FILE" 2>&1
  printf "Native map terrain and roads generated, validated, and scheduled.\n"
}

map_product_directory() {
  case "$1" in
    terrain) printf "map-tiles\n" ;;
    roads) printf "map-road-tiles\n" ;;
    *) return 1 ;;
  esac
}

validate_native_map_archive() {
  local archive="$1"
  local expected_directory="$2"
  local entry normalized listing entry_type
  printf "%s  %s\n" "$MAP_ARTIFACT_SHA256" "$archive" | sha256sum --check --status -
  tar -tzf "$archive" >/dev/null
  while IFS= read -r entry; do
    normalized="${entry#./}"
    normalized="${normalized%/}"
    [[ -z "$normalized" || "$normalized" == "." ]] && continue
    [[ "$normalized" != /* && "$normalized" != *\\* \
      && ! "$normalized" =~ (^|/)\.\.(/|$) \
      && ( "$normalized" == "$expected_directory" || "$normalized" == "$expected_directory/"* ) ]] \
      || { printf "Native map archive contains an unsafe path.\n" >&2; return 1; }
  done < <(tar -tzf "$archive")
  while IFS= read -r listing; do
    entry_type="${listing:0:1}"
    [[ "$entry_type" == "d" || "$entry_type" == "-" ]] \
      || { printf "Native map archive contains a non-regular entry.\n" >&2; return 1; }
  done < <(tar -tvzf "$archive")
}

install_native_map_product_archive() {
  local current_revision caller caller_home expected_archive archive_owner expected_directory secured_archive
  current_revision="$(basename "$(readlink -f "$CURRENT_LINK")")"
  [[ "$current_revision" == "$REVISION" ]] || {
    printf "Active revision %s does not match requested map revision %s.\n" "$current_revision" "$REVISION" >&2
    return 1
  }
  caller="${SUDO_USER:-}"
  [[ "$caller" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] || {
    printf "Map product installation requires an identified sudo caller.\n" >&2
    return 1
  }
  caller_home="$(getent passwd "$caller" | cut -d: -f6)"
  [[ -n "$caller_home" && "$caller_home" == /* && -d "$caller_home" ]] || {
    printf "Map product installer could not resolve the caller home.\n" >&2
    return 1
  }
  expected_archive="$caller_home/bitcraft-map-${MAP_INSTALL_PRODUCT}-${MAP_ARTIFACT_SHA256}.tar.gz"
  [[ -f "$expected_archive" && ! -L "$expected_archive" ]] || {
    printf "Expected map product archive is unavailable.\n" >&2
    return 1
  }
  archive_owner="$(stat -c %U "$expected_archive")"
  [[ "$archive_owner" == "$caller" ]] || {
    printf "Map product archive is not owned by the sudo caller.\n" >&2
    return 1
  }
  install -d -o root -g root -m 0700 "$LOG_DIR/incoming"
  secured_archive="$LOG_DIR/incoming/bitcraft-map-${MAP_INSTALL_PRODUCT}-${MAP_ARTIFACT_SHA256}.tar.gz"
  [[ ! -e "$secured_archive" && ! -L "$secured_archive" ]] || {
    printf "A secured map product archive already exists.\n" >&2
    return 1
  }
  mv -- "$expected_archive" "$secured_archive"
  chown root:root "$secured_archive"
  chmod 0600 "$secured_archive"
  MAP_IMPORT_ARCHIVE="$secured_archive"
  expected_directory="$(map_product_directory "$MAP_INSTALL_PRODUCT")"
  validate_native_map_archive "$MAP_IMPORT_ARCHIVE" "$expected_directory"

  install -d -o "$RUN_USER" -g "$RUN_USER" -m 0750 "$DATA_DIR"
  MAP_IMPORT_DIR="$(mktemp -d "$DATA_DIR/.map-import-${MAP_INSTALL_PRODUCT}-XXXXXX")"
  chown "$RUN_USER:$RUN_USER" "$MAP_IMPORT_DIR"
  tar --no-same-owner --no-same-permissions -xzf "$MAP_IMPORT_ARCHIVE" -C "$MAP_IMPORT_DIR"
  chown -R "$RUN_USER:$RUN_USER" "$MAP_IMPORT_DIR"
  run_logged "Installing verified $MAP_INSTALL_PRODUCT map product" sudo -u "$RUN_USER" node \
    "$CURRENT_LINK/apps/bitcraft-local/scripts/install-native-map-product.mjs" \
    --source-data-dir "$MAP_IMPORT_DIR" --data-dir "$DATA_DIR" --product "$MAP_INSTALL_PRODUCT"
  run_logged "Validating installed $MAP_INSTALL_PRODUCT map product" sudo -u "$RUN_USER" node \
    "$CURRENT_LINK/apps/bitcraft-local/scripts/verify-native-map-pack.mjs" \
    --data-dir "$DATA_DIR" --product "$MAP_INSTALL_PRODUCT"
  systemctl disable --now "$MAP_TERRAIN_TIMER" "$MAP_ROADS_TIMER" >>"$LOG_FILE" 2>&1
  rm -rf -- "$MAP_IMPORT_DIR"
  MAP_IMPORT_DIR=""
  rm -f -- "$MAP_IMPORT_ARCHIVE"
  MAP_IMPORT_ARCHIVE=""
  printf "Native map %s product installed and validated.\n" "$MAP_INSTALL_PRODUCT"
}

validate_relay_build_archive() {
  local archive="$1"
  local entry normalized listing entry_type
  printf "%s  %s\n" "$BUILD_ARTIFACT_SHA256" "$archive" | sha256sum --check --status -
  tar -tzf "$archive" >/dev/null
  while IFS= read -r entry; do
    normalized="${entry#./}"
    normalized="${normalized%/}"
    [[ -z "$normalized" || "$normalized" == "." ]] && continue
    [[ "$normalized" != /* && "$normalized" != *\\* && ! "$normalized" =~ (^|/)\.\.(/|$) ]] \
      || { printf "Relay build archive contains an unsafe path.\n" >&2; return 1; }
    case "$normalized" in
      build-manifest.json|apps|apps/bitcraft-local|apps/bitcraft-local/dist|apps/bitcraft-local/dist/*|apps/bitcraft-local/dist-server|apps/bitcraft-local/dist-server/*|apps/bitcraft-local/dist-bindings|apps/bitcraft-local/dist-bindings/*) ;;
      *) printf "Relay build archive contains an unexpected path.\n" >&2; return 1 ;;
    esac
  done < <(tar -tzf "$archive")
  while IFS= read -r listing; do
    entry_type="${listing:0:1}"
    [[ "$entry_type" == "d" || "$entry_type" == "-" ]] \
      || { printf "Relay build archive contains a non-regular entry.\n" >&2; return 1; }
  done < <(tar -tvzf "$archive")
}

prepare_relay_build_artifact() {
  local caller caller_home expected_archive archive_owner secured_archive
  caller="${SUDO_USER:-}"
  [[ "$caller" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] || {
    printf "Build artifact installation requires an identified sudo caller.\n" >&2
    return 1
  }
  caller_home="$(getent passwd "$caller" | cut -d: -f6)"
  [[ -n "$caller_home" && "$caller_home" == /* && -d "$caller_home" ]] || {
    printf "Build artifact installer could not resolve the caller home.\n" >&2
    return 1
  }
  expected_archive="$caller_home/bitcraft-build-${BUILD_ARTIFACT_SHA256}.tar.gz"
  [[ -f "$expected_archive" && ! -L "$expected_archive" ]] || {
    printf "Expected Relay build archive is unavailable.\n" >&2
    return 1
  }
  archive_owner="$(stat -c %U "$expected_archive")"
  [[ "$archive_owner" == "$caller" ]] || {
    printf "Relay build archive is not owned by the sudo caller.\n" >&2
    return 1
  }
  install -d -o root -g root -m 0700 "$LOG_DIR/incoming"
  secured_archive="$LOG_DIR/incoming/bitcraft-build-${BUILD_ARTIFACT_SHA256}.tar.gz"
  [[ ! -e "$secured_archive" && ! -L "$secured_archive" ]] || {
    printf "A secured Relay build archive already exists.\n" >&2
    return 1
  }
  mv -- "$expected_archive" "$secured_archive"
  chown root:root "$secured_archive"
  chmod 0600 "$secured_archive"
  BUILD_IMPORT_ARCHIVE="$secured_archive"
  validate_relay_build_archive "$BUILD_IMPORT_ARCHIVE"
  [[ -d "$APP_ROOT" && ! -L "$APP_ROOT" ]] || {
    printf "Relay application root is unavailable.\n" >&2
    return 1
  }
  BUILD_IMPORT_DIR="$(mktemp -d "$APP_ROOT/.build-import-XXXXXX")"
  chown "$RUN_USER:$RUN_USER" "$BUILD_IMPORT_DIR"
  tar --no-same-owner --no-same-permissions -xzf "$BUILD_IMPORT_ARCHIVE" -C "$BUILD_IMPORT_DIR"
  chown -R "$RUN_USER:$RUN_USER" "$BUILD_IMPORT_DIR"
}

finish_relay_build_artifact() {
  if [[ -n "$BUILD_IMPORT_DIR" && "$BUILD_IMPORT_DIR" == "$APP_ROOT"/.build-import-* ]]; then
    rm -rf -- "$BUILD_IMPORT_DIR"
  fi
  BUILD_IMPORT_DIR=""
  if [[ -n "$BUILD_IMPORT_ARCHIVE" \
    && "$BUILD_IMPORT_ARCHIVE" == */bitcraft-build-${BUILD_ARTIFACT_SHA256}.tar.gz ]]; then
    rm -f -- "$BUILD_IMPORT_ARCHIVE"
  fi
  BUILD_IMPORT_ARCHIVE=""
